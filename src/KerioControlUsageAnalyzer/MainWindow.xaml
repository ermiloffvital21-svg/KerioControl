<Window x:Class="KerioControlUsageAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KerioControl Usage Analyzer"
        Width="1240"
        Height="760"
        MinWidth="1000"
        MinHeight="650">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#D5D5D5"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="KerioControl URL" />
                <TextBox Grid.Column="0" Grid.Row="1" Margin="0,4,8,0" Text="{Binding Config.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="1" Grid.Row="0" Text="Логин" />
                <TextBox Grid.Column="1" Grid.Row="1" Margin="0,4,8,0" Text="{Binding Config.Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Пароль" />
                <PasswordBox Grid.Column="2" Grid.Row="1"
                             Margin="0,4,8,0"
                             PasswordChanged="PasswordBox_OnPasswordChanged" />

                <TextBlock Grid.Column="3" Grid.Row="0" Text="От" />
                <DatePicker Grid.Column="3" Grid.Row="1" Margin="0,4,8,0" SelectedDate="{Binding FromDate}" />

                <TextBlock Grid.Column="4" Grid.Row="0" Text="До" />
                <DatePicker Grid.Column="4" Grid.Row="1" Margin="0,4,8,0" SelectedDate="{Binding ToDate}" />

                <Button Grid.Column="5"
                        Grid.Row="1"
                        MinWidth="180"
                        Margin="0,4,0,0"
                        Command="{Binding LoadLogsCommand}"
                        Content="Загрузить и анализировать" />


                <TextBlock Grid.Column="0" Grid.Row="2" Text="Log method" />
                <TextBox Grid.Column="0" Grid.Row="3" Margin="0,4,8,0" Text="{Binding Config.PreferredLogMethod, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="4" Text="Log names (CSV)" />
                <TextBox Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4" Margin="0,4,8,0" Text="{Binding Config.LogNamesCsv, UpdateSourceTrigger=PropertyChanged}" />


                <TextBlock Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="5" Text="Custom @params JSON (optional)" />
                <TextBox Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="5" Margin="0,4,8,0" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Config.CustomParamsJson, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Column="0"
                          Grid.Row="6"
                          Grid.ColumnSpan="4"
                          Margin="0,10,8,0"
                          Content="Игнорировать ошибки TLS сертификата (для self-signed KerioControl)"
                          IsChecked="{Binding Config.IgnoreTlsCertificateErrors}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Сырые записи" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding Logs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp}" Width="160" />
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="130" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Трафик (байт)" Binding="{Binding Bytes}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Сводка по пользователям">
                <DataGrid ItemsSource="{Binding UserSummaries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Хостов" Binding="{Binding DistinctHosts}" Width="90" />
                        <DataGridTextColumn Header="Запросов" Binding="{Binding RequestsCount}" Width="90" />
                        <DataGridTextColumn Header="Трафик (МБ)" Binding="{Binding TrafficMb}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
